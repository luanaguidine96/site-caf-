@keyframes wave  /* criar uma animaçao chamada wave*/
   0%, 100% {
    transform: translateY(0);
  }/*inicio e fim*/

 50% {
    transform: translateY(-10px);
  }/*meio*/


 transform: scale(1.2); /*aumenta a imagem para 1,2 vezes o tamanho original*/

